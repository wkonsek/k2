Source "docs/demo/settings.tape"
Output "docs/demo/pulse-favorites.gif"
Set TypingSpeed 60ms

Hide
Type "source docs/demo/env.sh && demo_reset && clear"
Enter
Sleep 1s
Show

Type "k2"
Sleep 300ms
Enter
Sleep 1.5s

Type "b"
Sleep 800ms
Type "a"
Sleep 1s
Escape
Sleep 400ms
Type "c"
Sleep 500ms
Type "j"
Enter
Sleep 600ms
Enter
Sleep 1.5s
Type "0"
Sleep 1.5s
Type "0"
Sleep 1s
Type "b"
Sleep 800ms
Type "1"
Sleep 1.2s

Type ":pulse"
Enter
Sleep 2.5s
Type "jjj"
Sleep 600ms
Type "q"
Sleep 600ms

Type ":deploy"
Enter
Sleep 1.2s
Type "jj"
Sleep 400ms
Type "i"
Sleep 800ms
Backspace 8
Sleep 300ms
Type "8-alpine"
Sleep 400ms
Enter
Sleep 1.2s
Type "y"
Sleep 2.2s
